  const btn=x=>`<button class="csb tap" data-act="csug" data-n="${esc(x.n)}"><span class="cl">${x.g?`<img src="${esc(x.g.img)}" alt="">`:ic('gamepad')}</span><span>${esc(x.n)} Mod</span>${ic('chev','ch')}</button>`;
  return `<div class="page nonav">${topbar(`<div style="text-align:right;font-style:italic;font-size:13px;color:#7fd4ff;line-height:1.3">Xin Cấp Phép Bản Quyền Mod<br><b class="ttl h4">CR29 GAMING</b></div>`)}${crownTop()}
  ${hud(`<div class="hd"><div class="ric">${ic('shield')}</div><div><div class="ttl h2">Liên Hệ Bản Quyền Mod</div><div class="sub">Vui lòng chọn mod cần xin phép và gửi yêu cầu của bạn.</div></div></div>`,'cut20')}
  <div class="mt12">${hud(`<div class="msgs" id="msgs" style="padding:10px">${msgsInner(sp)}</div>`,'cut16')}</div>
  <div class="mt12">${hud(`<div class="csug"><div class="csh">${ic('layers')}Chọn Mod Cần Xin Phép</div><div class="csg">${copyMods().map(btn).join('')}${btn({n:'Các Mod Khác',g:null}).replace('Các Mod Khác Mod','Các Mod Khác').replace(ic('gamepad'),ic('dots'))}</div><div class="csinfo">${ic('info')}<span>Vui lòng chọn đúng mod bạn muốn xin phép để chúng tôi hỗ trợ nhanh nhất!</span></div></div>`,'cut16 lite')}</div>
  <div class="mt12" style="position:sticky;bottom:6px;z-index:4">${composer('copyright')}</div><div class="footline mt8">CR29 GAMING - Đồng Hành Cùng Bạn</div></div>`;
