function attachHTML(m){
  if(m.type==='image')return `<img class="mimg" data-blob="${m.blob}" data-act="zoom" alt="Ảnh góp ý">`;
  if(m.type==='voice')return `<audio controls preload="metadata" data-blob="${m.blob}"></audio>`;
  if(m.type==='file')return `<a class="mfile" data-blob="${m.blob}" download="${esc(m.name)}">${ic('file')}<span>${esc(m.name)}<small>${fSize(m.size||0)}</small></span></a>`;
  return esc(m.text);
}
