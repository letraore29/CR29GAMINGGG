/* ---------- KHUNG CHAT DÙNG CHUNG ---------- */
const EMOJIS='😀 😁 😂 🤣 😊 😍 😘 😎 🤩 🥳 😅 😉 🙂 🙃 😇 🤔 😴 😭 😡 😱 👍 👎 👏 🙏 💪 🔥 ⭐ ❤️ 💙 💯 🎮 ⚽ 🏆 🎁 🚀 ✅ ❌ 📌 👋'.split(' ');
function msgHTML(m,viewer){
  const mine=viewer==='admin'?m.from==='admin':m.from==='user';
  const u=userById(m.uid);let av='',who='';
  if(!mine){
    if(m.from==='admin'){av=`<div class="av40">${DB.admin.avatar?`<img src="${esc(DB.admin.avatar)}" alt="">`:ic('crown')}</div>`;who=`<div class="who">Admin <span class="tagadm">ADMIN</span></div>`}
    else{av=`<div class="av40">${u&&u.avatar?`<img src="${esc(u.avatar)}" alt="">`:ic('user')}</div>`;who=`<div class="who">${esc(u?u.username:'Người chơi')}</div>`}
  }
  let body='';
  if(m.type==='image')body=`<img class="mimg" data-blob="${m.blob}" data-act="zoom" alt="Hình ảnh đã gửi">`;
  else if(m.type==='voice')body=`<audio controls preload="metadata" data-blob="${m.blob}"></audio>`;
  else if(m.type==='file')body=`<a class="mfile" data-blob="${m.blob}" download="${esc(m.name)}">${ic('file')}<span>${esc(m.name)}<small>${fSize(m.size||0)}</small></span></a>`;
  else body=esc(m.text);
  const st=m.kind==='copyright'?`<span class="st ${m.status}">${STL[m.status]||''}</span>`:'';
  const like=(m.kind==='feedback'&&m.liked&&viewer==='user'&&mine)?`<div class="liken">${ic('like')}Admin đã like góp ý của bạn</div>`:'';
  return `<div class="msg ${mine?'me':''}">${av}<div class="bcol">${who}<div class="bub">${body}</div><div class="mtm"><span>${fTime(m.ts)}</span>${st}</div>${like}</div></div>`;
}
const greet=t=>`<div class="msg"><div class="av40">${DB.admin.avatar?`<img src="${esc(DB.admin.avatar)}" alt="">`:ic('crown')}</div><div class="bcol"><div class="who">Admin <span class="tagadm">ADMIN</span></div><div class="bub">${esc(t)}</div></div></div>`;
const GREET_FB='Bạn cần góp ý điều gì, chúng tôi sẵn sàng lắng nghe và rút kinh nghiệm nếu hợp lí. Cảm ơn bạn <3';
const GREET_CR='Bạn cần sử dụng mod nào hãy chọn và gửi cho chúng tôi biết. Sau 24h chúng tôi sẽ duyệt ngay lập tức nếu hợp lí. Cảm ơn bạn!';
function chatSpec(cur){
  const u=curUser(),n=cur.name;
  if(n==='messages'&&u)return{kind:'support',uid:u.id,from:'user',viewer:'user'};
  if(n==='feedback'&&u)return{kind:'feedback',uid:u.id,from:'user',viewer:'user'};
  if(n==='copyright'&&u)return{kind:'copyright',uid:u.id,from:'user',viewer:'user'};
  if(n==='adminChat'&&isAdmin())return{kind:'support',uid:cur.params.uid,from:'admin',viewer:'admin'};
  return null;
}
function msgsInner(sp){
  const l=thread(sp.kind,sp.uid);
  let h=sp.kind==='feedback'?greet(GREET_FB):sp.kind==='copyright'?greet(GREET_CR):'';
  h+=l.map(m=>msgHTML(m,sp.viewer)).join('');
  if(!l.length&&sp.kind!=='copyright')h+=`<div class="none">${ic('chat')}<div class="ttl h4">Chưa có tin nhắn</div><div>${sp.kind==='feedback'?'Hãy là người đầu tiên gửi tin nhắn<br>để đóng góp ý kiến nhé!':sp.viewer==='admin'?'Hãy gửi lời chào đầu tiên tới người chơi.':'Hãy gửi tin nhắn để admin hỗ trợ bạn.'}</div></div>`;
  return h;
}
function refreshMsgs(force){
  const el=$('#msgs');if(!el)return;
  const sp=chatSpec(topv());if(!sp)return;
  const sc=topv().name==='copyright'?$('#scroll'):el;
  const atB=sc.scrollHeight-sc.scrollTop-sc.clientHeight<90;
  el.innerHTML=msgsInner(sp);hydrate(el);
  if(atB||force)sc.scrollTop=sc.scrollHeight;
}
const scrollChatBottom=()=>{const n=topv().name;const sc=n==='copyright'?$('#scroll'):$('#msgs');if(sc)sc.scrollTop=sc.scrollHeight};
function composer(type){
  const rec=`<div class="recbar" id="recbar"><i class="dot"></i><span class="rt" id="rectime">Đang ghi âm 0:00</span><button class="cn tap" data-act="reccancel">Hủy</button><button class="sd tap" data-act="recsend">Gửi</button></div>`;
  const inp=`<input class="tin" id="msgin" placeholder="${type==='feedback'?'Nhập nội dung...':type==='copyright'?'Nhập nội dung yêu cầu của bạn...':'Nhập tin nhắn...'}" autocomplete="off" maxlength="2000" aria-label="Nội dung tin nhắn">`;
  const send=`<button class="ibtn send tap" data-act="send" aria-label="Gửi">${ic('send')}</button>`;
  if(type==='support')return hud(`<div class="comp">${rec}<div class="r1"><button class="ibtn tap" data-act="emoji" aria-label="Biểu tượng cảm xúc">${ic('smile')}</button>${inp}${send}</div><div class="acts a4"><label class="abtn tap">${ic('image')}<span>Gửi hình ảnh</span>${fin('sendimg','image/*','multiple')}</label><label class="abtn tap">${ic('file')}<span>Gửi tệp</span>${fin('sendfile','*/*','multiple')}</label><label class="abtn tap">${ic('camera')}<span>Chụp ảnh</span>${fin('sendcam','image/*','capture="environment"')}</label>${micBtn('big')}</div></div>`,'cut16');
  if(type==='feedback')return hud(`<div class="comp">${rec}<div class="r1"><label class="ibtn tap" aria-label="Gửi file game">${ic('plus')}${fin('sendfile','*/*','multiple')}</label>${inp}<label class="ibtn tap" aria-label="Gửi ảnh">${ic('image')}${fin('sendimg','image/*','multiple')}</label>${micBtn('icon')}${send}</div><div class="acts a2"><label class="abtn row tap">${ic('image')}<span>Gửi Ảnh</span>${fin('sendimg','image/*','multiple')}</label>${micBtn('row')}</div></div>`,'cut16');
  return hud(`<div class="comp"><div class="r1"><label class="ibtn tap" aria-label="Đính kèm">${ic('clip')}${fin('sendfile','*/*','multiple')}</label>${inp}${send}</div></div>`,'cut16');
}

