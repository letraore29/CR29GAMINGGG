const TOAST_IC={ok:'check',err:'x',info:'info',lock:'lock'};
function toast(msg,o={}){
  const t=o.type||'ok',ms=o.ms||(t==='ok'?3000:3500);
  const box=$('#toasts');
  while(box.children.length>=4)box.firstChild.remove();
  const el=document.createElement('div');
  el.className='toast '+t;el.setAttribute('role','status');el.style.setProperty('--dur',ms+'ms');
  el.innerHTML=`<span class="ti">${ic(TOAST_IC[t]||'check')}</span><span>${esc(msg)}</span>`;
  box.appendChild(el);
  setTimeout(()=>{el.classList.add('out');setTimeout(()=>el.remove(),380)},ms);
}
