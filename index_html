const Music={el:new Audio(),src:'',gesture:false,preview:'',muted:false};
Music.el.loop=true;Music.el.preload='auto';
try{Music.muted=localStorage.getItem('cr29_muted')==='1'}catch(e){}
function activeTrack(){
  const s=DB.settings;
  if(isPro()&&s.proTrackId){const t=s.proTracks.find(x=>x.id===s.proTrackId);if(t)return t}
  if(s.trackId){const t=s.tracks.find(x=>x.id===s.trackId);if(t)return t}
  return null;
}
async function musicSync(){
  if(Music.preview)return;
  const t=activeTrack(),s=DB.settings;
  const btn=$('#snd');
  if(!t||!s.soundOn){Music.el.pause();Music.src='';if(btn)btn.classList.remove('on');return}
  if(btn){btn.classList.add('on');btn.classList.toggle('off',Music.muted);btn.innerHTML=ic(Music.muted?'spkoff':'spk')}
  if(Music.muted){Music.el.pause();return}
  if(Music.src!==t.blobId){const u=await blobURL(t.blobId);if(!u)return;Music.src=t.blobId;Music.el.src=u}
  if(Music.gesture)Music.el.play().catch(()=>{});
}
function firstGesture(){if(Music.gesture)return;Music.gesture=true;musicSync()}
['pointerdown','keydown','touchstart'].forEach(ev=>document.addEventListener(ev,firstGesture,{once:false,passive:true}));

