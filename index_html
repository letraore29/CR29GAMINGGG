H.login=()=>{
  const un=$('#lu').value.trim(),pw=$('#lp').value;
  setErr('lu','');setErr('lp','');$('#ferr').textContent='';
  let bad=false;
  if(!un){setErr('lu','Vui lòng nhập tên đăng nhập');bad=true}
  if(!pw){setErr('lp','Vui lòng nhập mật khẩu');bad=true}
  if(bad)return;
  const r=doLogin(un,pw);
  if(!r.ok){$('#ferr').textContent=r.msg;toast(r.msg,{type:'err',ms:4500});return}
  stack=[{name:'account'}];render();
  toast(r.role==='admin'?'Đăng nhập admin thành công':'Đăng nhập thành công');
  afterLogin();
};
H.register=()=>{
  const un=$('#ru').value.trim(),em=$('#re').value.trim(),pw=$('#rp').value,pw2=$('#rp2').value;
  ['ru','re','rp','rp2'].forEach(i=>setErr(i,''));
  let first='';const bad=(id,m)=>{setErr(id,m);if(!first)first=id};
  if(!un)bad('ru','Vui lòng nhập tên đăng nhập');
  else if(ukey(un)===ukey(DB.admin.username)||DB.users.some(x=>ukey(x.username)===ukey(un)))bad('ru','Tên đăng nhập này đã có người sử dụng');
  if(!em)bad('re','Vui lòng nhập email');
  else if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em))bad('re','Email không hợp lệ');
  else if(DB.users.some(x=>ukey(x.email)===ukey(em)))bad('re','Email này đã được đăng ký');
  if(!pw)bad('rp','Vui lòng nhập mật khẩu');
  else if(pw.length<6)bad('rp','Mật khẩu phải có tối thiểu 6 ký tự');
  if(!pw2)bad('rp2','Vui lòng nhập lại mật khẩu');
  else if(pw2!==pw)bad('rp2','Mật khẩu nhập lại không khớp');
  if(first){const f=$('#'+first);if(f)f.focus();return}
  DB.users.push({id:DB.nextUid++,username:un,email:em,password:pw,avatar:'',pro:false,locked:false,created:now(),favs:[],downloads:[],noticeSeen:0});
  saveNow();
  toast('Tạo Tài Khoản Thành Công',{ms:3000});
  stack=[{name:'account'},{name:'login',params:{u:un}}];render();
  const p=$('#lp');if(p)p.focus();
};
