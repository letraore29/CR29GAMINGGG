<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#020a1f">
<title>CR29 Gaming - Mod Game</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,400;0,600;0,800;1,400;1,600;1,800&amp;family=Roboto:wght@400;500;700&amp;family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&amp;family=Saira:wght@400;600;800&amp;family=Be+Vietnam+Pro:wght@400;600;800&amp;family=Baloo+2:wght@500;700;800&amp;display=swap" rel="stylesheet">
<style>
:root{
 --ink:#eaf4ff;--dim:#8db6ee;--blue:#2f8bff;--cyan:#22d6ff;--pink:#ff4fa3;--green:#2ee59d;--red:#ff4257;--gold:#ffc21a;
 --site-color:#ffc21a;--site-glow:rgba(255,194,26,.55);--pro-color:#a855f7;--pro-glow:rgba(168,85,247,.55);
 --edge:#2f8bff;--edge2:#22d6ff;--glow:rgba(47,139,255,.6);
 --fh:'Exo 2',system-ui,'Segoe UI',sans-serif;--fb:'Roboto',system-ui,'Segoe UI',sans-serif;--fst:italic;
}
body.role-admin{--edge:var(--site-color);--edge2:var(--site-color);--glow:var(--site-glow)}
body.role-pro{--edge:var(--pro-color);--edge2:var(--pro-color);--glow:var(--pro-glow)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:#010510;color:var(--ink);font-family:var(--fb);font-size:15px}
body{overflow:hidden;background:radial-gradient(80% 60% at 50% 0,#0a2e7a33,transparent),#010510}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;text-align:inherit}
input,textarea,select{font:inherit;color:inherit}
a{color:inherit;text-decoration:none;cursor:pointer}
img{-webkit-user-drag:none}
.tap{cursor:pointer;transition:transform .12s,filter .12s}
.tap:active{transform:scale(.97);filter:brightness(1.25)}
:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}

/* ===== khung máy ===== */
#shell{position:relative;max-width:480px;height:100dvh;margin:0 auto;overflow:hidden;
 background:radial-gradient(120% 55% at 50% -8%,#0c40a866,transparent 62%),radial-gradient(90% 45% at 100% 100%,#0a2e8a44,transparent 60%),linear-gradient(#020a1f,#03112f);
 box-shadow:0 0 0 1px #0d2a6b,0 0 70px #0a3fbf44}
#shell::before{content:'';position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(115deg,transparent 0 54px,rgba(47,139,255,.055) 54px 56px)}
#scroll{position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
#scroll::-webkit-scrollbar{display:none}
#scroll.fit{overflow:hidden}
.page{position:relative;padding:14px 12px calc(98px + env(safe-area-inset-bottom));min-height:100%}
.page.nonav{padding-bottom:calc(30px + env(safe-area-inset-bottom))}
.page.fit{height:100%;display:flex;flex-direction:column;min-height:0;padding-bottom:calc(92px + env(safe-area-inset-bottom));gap:8px}
.page.fit.nonav{padding-bottom:calc(10px + env(safe-area-inset-bottom))}

/* ===== khung HUD vát góc ===== */
.hudw{--cut:14px;position:relative;display:flex;filter:drop-shadow(0 0 5px var(--glow))}
.hudw.lite{filter:none}
.hudw.cut8{--cut:8px}.hudw.cut10{--cut:10px}.hudw.cut12{--cut:12px}.hudw.cut16{--cut:16px}.hudw.cut20{--cut:20px}
.hud{flex:1;min-width:0;display:flex;padding:2px;
 background:linear-gradient(135deg,var(--edge),var(--edge2) 45%,var(--edge));
 clip-path:polygon(var(--cut) 0,calc(100% - var(--cut)) 0,100% var(--cut),100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,var(--cut) 100%,0 calc(100% - var(--cut)),0 var(--cut))}
.hud-in{flex:1;min-width:0;min-height:0;display:block;position:relative;
 background:linear-gradient(180deg,rgba(9,38,100,.93),rgba(4,17,50,.97));
 box-shadow:inset 0 0 22px rgba(47,139,255,.28);
 clip-path:polygon(calc(var(--cut) - 1.2px) 0,calc(100% - var(--cut) + 1.2px) 0,100% calc(var(--cut) - 1.2px),100% calc(100% - var(--cut) + 1.2px),calc(100% - var(--cut) + 1.2px) 100%,calc(var(--cut) - 1.2px) 100%,0 calc(100% - var(--cut) + 1.2px),0 calc(var(--cut) - 1.2px))}
body.role-admin .hud-in{box-shadow:inset 0 0 0 1.5px rgba(47,139,255,.95),inset 0 0 26px rgba(47,139,255,.3)}
.hudw.dim{opacity:.42;filter:none;pointer-events:none}
.hudw.flat .hud-in{display:flex;flex-direction:column}

/* ===== chữ ===== */
.ttl{font-family:var(--fh);font-style:var(--fst);font-weight:800;letter-spacing:.2px;line-height:1.15;
 background:linear-gradient(180deg,#fff,#b4e2ff 62%,#5bb6ff);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 7px rgba(47,139,255,.85))}
.h1{font-size:38px}.h2{font-size:26px}.h3{font-size:21px}.h4{font-size:17px}
.gold{background:linear-gradient(180deg,#fff6c9,#ffd23f 60%,#ffb000);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 8px rgba(255,190,30,.7))}
.sub{color:#5fdcff;font-style:italic;font-size:14px}
.dimtxt{color:var(--dim)}
.center{text-align:center}
.ic{width:24px;height:24px;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.ic.sm{width:18px;height:18px}.ic.lg{width:32px;height:32px}
.ic.fill{fill:currentColor}
.brand{width:100%;height:100%}

/* ===== thanh trên + nút quay lại ===== */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px;position:relative;z-index:3}
.bkw{width:fit-content}
.bk{display:flex;align-items:center;gap:8px;padding:8px 18px 8px 14px;font-family:var(--fh);font-style:italic;font-weight:700;color:#fff}
.crown-top{display:flex;justify-content:center;color:var(--edge2);margin:-6px 0 -2px;filter:drop-shadow(0 0 8px var(--glow))}
.crown-top .ic{width:54px;height:54px;stroke-width:1.5}
.hd{display:flex;align-items:center;gap:14px;padding:14px 18px}
.hd>div:last-child{min-width:0}
.ric{flex:none;width:58px;height:58px;border-radius:50%;border:2.5px solid var(--edge2);display:grid;place-items:center;color:#7fe4ff;background:radial-gradient(circle,#0a3a9c66,#04123a);box-shadow:0 0 14px var(--glow),inset 0 0 12px rgba(47,139,255,.4)}
.ric .ic{width:30px;height:30px}
.ric.sm{width:46px;height:46px}.ric.sm .ic{width:24px;height:24px}
.stack{display:flex;flex-direction:column;gap:12px}
.mt8{margin-top:8px}.mt12{margin-top:12px}.mt16{margin-top:16px}.mt20{margin-top:20px}

/* ===== mục (section) ===== */
.sec{display:flex;align-items:center;gap:9px;margin:18px 2px 10px;color:var(--cyan)}
.sec .ttl{font-size:22px;white-space:nowrap}
.sec .ln{flex:1;height:2px;background:linear-gradient(90deg,var(--edge2),transparent);opacity:.85;min-width:12px}
.sec a{color:var(--cyan);font-size:14px;display:inline-flex;align-items:center;white-space:nowrap}
.sec a .ic{width:18px;height:18px}

/* ===== chip ===== */
.chips{display:flex;gap:8px;margin:12px 0 2px}
.chips.scroll{overflow-x:auto;scrollbar-width:none;padding:2px 2px 6px;margin-left:-2px}
.chips.scroll::-webkit-scrollbar{display:none}
.chips.wrap{flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:8px;padding:0 16px;min-height:42px;flex:none;border-radius:999px;border:1.5px solid var(--edge);background:rgba(5,24,68,.85);color:#e5f1ff;font-size:14px;white-space:nowrap;transition:.15s}
.chip .ic{width:19px;height:19px}
.chip.on{background:linear-gradient(180deg,#2a80ff,#0b45c9);border-color:var(--edge2);box-shadow:0 0 14px var(--glow);color:#fff}

/* ===== thanh tìm kiếm ===== */
.sbar .hud-in{display:flex;align-items:center;overflow:hidden}
.sbar .si{padding:0 6px 0 14px;color:#cfe7ff;display:flex}
.sbar input{flex:1;min-width:0;height:48px;background:none;border:0;outline:0;color:#e9f4ff;font-size:16px}
.sbar input::placeholder{color:#7fa6e0}
.sbar .go{align-self:stretch;width:58px;display:grid;place-items:center;color:#fff;background:linear-gradient(180deg,#2a80ff,#0a47cf)}

/* ===== thẻ game ===== */
.g2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}
.gcw{cursor:pointer;min-width:0}
.gcard .gt{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:8px 8px 6px 12px;font-family:var(--fh);font-style:italic;font-weight:700;font-size:17px;min-height:42px}
.gcard .gt span{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.12;font-size:15.5px}
.gcard .gt{height:52px;min-height:0}
.gimg{display:block;width:100%;aspect-ratio:2.3/1;object-fit:cover;background:#061a44}
.hb{flex:none;width:34px;height:34px;display:grid;place-items:center;color:#ffd7ec;border-radius:50%}
.hb .ic{width:26px;height:26px;stroke-width:2}
.hb.on{color:var(--pink)}
.hb.on .ic{fill:var(--pink);stroke:#ff9fce;filter:drop-shadow(0 0 7px var(--pink))}
.hb.pop .ic{animation:pop .35s}
@keyframes pop{40%{transform:scale(1.35)}}
.scard{cursor:pointer}
.scard .sr{display:flex;align-items:center;gap:10px;padding:10px}
.scard img{width:62px;height:62px;border-radius:10px;object-fit:cover;flex:none;border:1.5px solid var(--edge)}
.scard .sn{min-width:0;flex:1}
.scard b{display:block;font-family:var(--fh);font-style:italic;font-size:16px;line-height:1.2}
.scard small{display:block;color:var(--dim);font-size:12.5px;margin-top:3px}
.empty{padding:26px 14px;text-align:center;color:var(--dim)}
.empty .ic{width:44px;height:44px;color:var(--edge2);margin-bottom:8px}

/* ===== kết quả không tìm thấy ===== */
.results{position:relative}
.ghosts{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;opacity:.5;filter:blur(1.5px)}
.ghost .gr{display:flex;align-items:center;gap:12px;padding:22px 14px;color:#4b86dd}
.ghost .gr .ic{width:56px;height:56px;flex:none}
.ghost .bars{flex:1}.ghost .bars i{display:block;height:11px;border-radius:5px;background:#12409a;margin:7px 0}
.veil{position:absolute;inset:-4px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;padding:20px;
 backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);background:rgba(2,10,32,.6);border:1.5px solid rgba(47,139,255,.45);border-radius:16px;animation:fadein .25s}
.veil .ic{width:52px;height:52px;color:var(--edge2)}
@keyframes fadein{from{opacity:0}}

/* ===== chi tiết game ===== */
.hero{position:relative;margin:0 -12px 10px}
.hero img{display:block;width:100%;aspect-ratio:2.35/1;object-fit:cover;background:#061a44}
.hero::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 55%,#03112f)}
.dlh{display:flex;align-items:center;gap:12px;padding:12px 16px}
.dlh .ric{width:46px;height:46px}
.fgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:8px 12px 14px}
.fcard{cursor:pointer}
.fcard .fc{display:flex;flex-direction:column;align-items:center;gap:8px;padding:12px 4px 10px;text-align:center;width:100%}
.fcard .fcr{width:62px;height:62px;border-radius:50%;border:2.5px solid var(--edge2);display:grid;place-items:center;color:#7fe4ff;background:radial-gradient(circle,#0a3a9c66,#04123a);box-shadow:0 0 12px var(--glow)}
.fcard .fcr .ic{width:32px;height:32px}
.fcard .fname{font-size:24px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 2px}
.fbtn{display:inline-flex;align-items:center;justify-content:center;gap:5px;width:100%;padding:8px 4px;border-radius:999px;border:1.5px solid var(--edge2);background:rgba(8,44,120,.7);font-size:12.5px;color:#eaf6ff;white-space:nowrap}
.fbtn .ic{width:15px;height:15px}
.mods{display:flex;gap:12px;padding:12px}
.mods img{width:36%;max-height:190px;aspect-ratio:1;object-fit:cover;border-radius:10px;border:1.5px solid var(--edge);align-self:flex-start}
.ml{flex:1;min-width:0}
.mi{display:flex;gap:9px;margin-bottom:11px}
.ck{flex:none;width:22px;height:22px;margin-top:1px;border-radius:50%;display:grid;place-items:center;border:1.5px solid var(--cyan);background:#0a3fc055;color:#fff}
.ck .ic{width:13px;height:13px;stroke-width:3}
.mi b{display:block;font-weight:500;font-size:14px;line-height:1.3}
.mi span{display:block;font-size:12.5px;color:#66bfff;line-height:1.3}
.strap{display:flex;align-items:center;justify-content:center;gap:10px;padding:12px 8px;text-align:center;color:var(--cyan)}
.strap .ttl{font-size:15px}

/* ===== hàng bấm (tài khoản, admin) ===== */
.arow{cursor:pointer}
.arow .ar{display:flex;align-items:center;gap:14px;padding:14px 16px;min-height:88px}
.arow .at{flex:1;min-width:0}
.arow .as{color:#bcd8ff;font-size:14px;margin-top:2px}
.arow .cv{color:var(--edge2);display:flex}
.arow .cv .ic{width:30px;height:30px;stroke-width:2.4}
.mrow{cursor:pointer}
.mrow .mr{display:flex;align-items:center;gap:14px;padding:11px 14px}
.mrow .mr .ttl{flex:1;font-size:19px;text-align:left}
.mrow .cv{color:var(--edge2);display:flex}
.mrow .cv .ic{width:26px;height:26px;stroke-width:2.4}
.mrow .mi2{flex:none;width:44px;height:44px;border-radius:50%;border:2px solid var(--edge2);display:grid;place-items:center;color:#dff2ff;background:radial-gradient(circle,#0a3a9c66,#04123a)}
.mrow .dot{width:9px;height:9px;border-radius:50%;background:var(--red);box-shadow:0 0 8px var(--red)}
.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}
.pbtn{display:flex;align-items:center;justify-content:center;gap:10px;padding:12px 8px;font-family:var(--fh);font-style:italic;font-weight:700;font-size:17px;cursor:pointer}
.pbtn .ic{width:24px;height:24px}

/* ===== trang đăng nhập / đăng ký ===== */
.authhead{text-align:center;margin:0 0 6px}
.bigav{width:112px;height:112px;margin:2px auto 8px;border-radius:50%;border:3px solid var(--edge2);display:grid;place-items:center;color:#7fe4ff;background:radial-gradient(circle,#0e46c088,#04123a);box-shadow:0 0 22px var(--glow),inset 0 0 20px rgba(47,139,255,.5);position:relative}
.bigav .ic{width:58px;height:58px}
.bigav .cr{position:absolute;top:-30px;left:50%;transform:translateX(-50%);color:var(--edge2)}
.bigav .cr .ic{width:44px;height:44px;stroke-width:1.6}
.subline{display:flex;align-items:center;justify-content:center;gap:10px;color:#4fdcff;font-style:italic;margin-top:6px;font-size:15px}
.subline .ic{width:26px;height:26px;stroke-width:2.6}
.formbox{padding:22px 18px 20px}
.fld{margin-bottom:12px}
.fld .lb{font-family:var(--fh);font-style:italic;font-weight:700;font-size:16px;margin:0 4px 6px;color:#fff}
.pill{display:flex;align-items:center;gap:6px;min-height:52px;padding:0 8px 0 10px;border-radius:16px;border:1.5px solid var(--edge);background:rgba(4,20,58,.85);box-shadow:inset 0 0 14px rgba(47,139,255,.2);transition:.15s}
.pill:focus-within{border-color:var(--edge2);box-shadow:0 0 14px var(--glow),inset 0 0 14px rgba(47,139,255,.3)}
.pill.err{border-color:var(--red);box-shadow:0 0 12px rgba(255,66,87,.4)}
.pill.ro{opacity:.75}
.pill .fi{flex:none;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#0a3a9c55;color:#7fd4ff}
.pill .fi.dim{background:none;color:#6d97d8}
.pill .fi .ic{width:20px;height:20px}
.inp{flex:1;min-width:0;height:48px;background:none;border:0;outline:0;color:#eaf4ff;font-size:16px;padding:0 6px}
.inp::placeholder{color:#7098d6}
textarea.inp{height:auto;padding:12px 6px;resize:none;line-height:1.4}
.eye{flex:none;width:38px;height:38px;display:grid;place-items:center;color:#8fbaf5}
.errtxt{color:#ff5d70;font-size:13px;margin:5px 6px 0;min-height:0}
.errtxt:empty{display:none}
.formerr{color:#ff5d70;text-align:center;font-size:14px;margin:0 0 10px;min-height:0}
.formerr:empty{display:none}
.linkr{display:flex;justify-content:flex-end;margin:-2px 4px 14px}
.linkr a,.lnk{color:#38d9ff;font-size:14px;display:inline-flex;align-items:center;gap:2px}
.lnk.u{text-decoration:underline;font-weight:500}
.bigbtn{width:100%;margin:6px 0 0;cursor:pointer}
.bigbtn .hud-in{background:linear-gradient(180deg,#2d84ff,#0a3fc4)}
.bigbtn .bb{display:flex;align-items:center;justify-content:center;gap:16px;min-height:56px;padding:0 16px;font-family:var(--fh);font-style:italic;font-weight:800;font-size:22px;color:#fff;text-shadow:0 0 10px rgba(160,220,255,.95)}
.bigbtn .bb .ic{width:26px;height:26px;stroke-width:2.6;color:#8fe6ff}
.bigbtn.green .hud-in{background:linear-gradient(180deg,#22c88a,#0a8f5e)}
.bigbtn.sm .bb{min-height:46px;font-size:18px}
.orsep{display:flex;align-items:center;gap:10px;color:var(--edge2);margin:18px 0 12px}
.orsep i{flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--edge2),transparent)}
.foot{text-align:center;color:#a9cdfd;font-size:14px}
.stage{height:120px;margin:16px -12px -30px;position:relative;pointer-events:none;background:radial-gradient(ellipse 70% 50% at 50% 100%,rgba(47,139,255,.45),transparent 70%)}
.stage::before,.stage::after{content:'';position:absolute;left:50%;transform:translateX(-50%);border-radius:50%;border:2px solid rgba(80,170,255,.55);box-shadow:0 0 18px rgba(47,139,255,.8)}
.stage::before{bottom:14px;width:78%;height:40px}
.stage::after{bottom:26px;width:52%;height:24px}

/* ===== trang hỗ trợ ===== */
.srow{cursor:pointer}
.srow .sr2{display:flex;align-items:center;gap:14px;padding:14px 16px}
.srow .lg{flex:none;width:66px;height:66px;border-radius:50%;border:2.5px solid var(--edge2);display:grid;place-items:center;background:radial-gradient(circle,#0a3a9c55,#04123a);padding:9px}
.copyrow{display:flex;align-items:center;gap:10px;margin:0 6px 4px;padding:10px 14px;border-radius:14px;border:1.5px dashed var(--edge2);background:rgba(4,20,58,.7)}
.copyrow span{flex:1;font-size:16px;letter-spacing:.5px}
.cbtn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;border:1.5px solid var(--edge2);background:rgba(8,44,120,.7);font-size:13.5px}
.cbtn .ic{width:16px;height:16px}

/* ===== hồ sơ ===== */
.prof{text-align:center;position:relative}
.prof .topr{position:absolute;right:0;top:0;z-index:3}
.logout .lo{display:flex;align-items:center;gap:8px;padding:9px 16px;font-family:var(--fh);font-style:italic;font-weight:700;font-size:15px;color:#fff}
.avring{position:relative;width:176px;height:176px;margin:34px auto 6px;display:grid;place-items:center}
.avring::before{content:'';position:absolute;inset:-6px;border-radius:50%;border:2px solid var(--edge2);box-shadow:0 0 22px var(--glow),inset 0 0 22px var(--glow);opacity:.9}
.avring .crn{position:absolute;top:-38px;left:50%;transform:translateX(-50%);color:var(--edge2);filter:drop-shadow(0 0 10px var(--glow))}
.avring .crn .ic{width:56px;height:56px;stroke-width:1.5}
.avimg{width:156px;height:156px;border-radius:50%;overflow:hidden;border:4px solid var(--edge2);display:grid;place-items:center;background:radial-gradient(circle,#123a94,#061a44);color:#8fb6ee;box-shadow:0 0 18px var(--glow)}
.avimg img{width:100%;height:100%;object-fit:cover}
.avimg .ic{width:96px;height:96px;stroke-width:1.4;fill:#7ea6e6;stroke:#7ea6e6}
.avimg .bigcrown{width:100%;height:100%;padding:16px}
.cam{position:absolute;right:6px;bottom:8px;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#06184a;border:2px solid var(--edge2);color:#fff;box-shadow:0 0 12px var(--glow);z-index:2}
.cam .ic{width:22px;height:22px}
