/* ---------- LIÊN HỆ BẢN QUYỀN ---------- */
function copyMods(){
  const base=['GTA San Andreas','eFootball 2025','FC Mobile','Free Fire','PUBG Mobile','Car Parking Multiplayer','Minecraft PE','Blox Fruit / Roblox','Dream League Soccer 2025'];
  const nb=base.map(norm);
  const extra=DB.games.filter(g=>!nb.some(b=>b.includes(norm(g.name))||norm(g.name).includes(b))).map(g=>g.name);
  return base.concat(extra).map(n=>({n,g:DB.games.find(g=>norm(g.name)===norm(n)||norm(n).includes(norm(g.name))||norm(g.name).includes(norm(n)))}));
}
