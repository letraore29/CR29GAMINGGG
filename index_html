   ?`<div class="rowgo"><span class="rbtn" style="flex:1">${ic('ok')}Đã Tải</span><span class="rbtn go2" style="flex:none;width:30px">${ic('chevs')}</span></div><button class="rbtn rm tap" data-act="rmdl" data-id="${g.id}">${ic('trash')}Xóa</button>`
   :`<div class="rowgo"><span class="rbtn pinkb" style="flex:1">${ic('heart')}Đã yêu thích</span><span class="rbtn go2" style="flex:none;width:30px">${ic('chevs')}</span></div><button class="rbtn rm tap" data-act="unfav" data-id="${g.id}">${ic('heart')}${ic('trash')}Xóa Yêu Thích</button>`;
