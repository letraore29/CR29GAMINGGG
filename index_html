async function sendMsg({kind,uid,from,type='text',text='',file=null}){
  let blob='',name='',size=0;
  if(file){blob=await putBlob(file);name=file.name||'';size=file.size||0}
  DB.msgs.push({id:gid(),kind,uid,from,type,text,blob,name,size,ts:now(),status:kind==='copyright'&&from==='user'?'pending':'',liked:false,likeSeen:true});
