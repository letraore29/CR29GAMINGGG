const chatCtx=()=>{const sp=chatSpec(topv());return sp?{kind:sp.kind,uid:sp.uid,from:sp.from}:null};
async function sendPicked(files,asImage){
  const ctx=chatCtx();if(!ctx)return;
  for(const f of files){
    try{
      if(f.size>40*1048576){toast('Tệp "'+f.name+'" quá lớn (tối đa 40 MB)',{type:'err'});continue}
      if(asImage||f.type.startsWith('image/')){
        const b=await imgToBlob(f,1280,.85);
        await sendMsg({...ctx,type:'image',file:new File([b],(f.name||'anh').replace(/\.[^.]+$/,'')+'.jpg',{type:'image/jpeg'})});
      }else await sendMsg({...ctx,type:'file',file:f});
    }catch(e){toast('Không gửi được "'+f.name+'"',{type:'err'})}
  }
  refreshMsgs(true);
  if(ctx.kind==='copyright')toast('Đã gửi yêu cầu. Trạng thái: Chờ duyệt',{type:'info'});
}

