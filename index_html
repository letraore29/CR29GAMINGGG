H.delnote=el=>{DB.notices=DB.notices.filter(n=>n.id!==el.dataset.id);saveNow();$('#notesl').innerHTML=notesAdminHTML();toast('Đã xóa',{type:'info',ms:2000})};

/* ---------- admin: hiệu ứng ---------- */
FH.addtrack=async(fs,inp)=>{
  const w=inp.dataset.w,d=FXD();let n=0;
  for(const f of fs){
    if(f.size>30*1048576){toast('"'+f.name+'" quá lớn (tối đa 30 MB)',{type:'err'});continue}
    try{const blobId=await putBlob(f);d[w].push({id:gid(),name:f.name.replace(/\.[^.]+$/,''),blobId});n++}
    catch(e){toast('Không lưu được "'+f.name+'"',{type:'err'})}
  }
  if(n){refreshFx();toast('Đã thêm '+n+' âm thanh. Nhấn nút phát để nghe, rồi Lưu Hiệu Ứng.',{type:'info',ms:3500})}
};
H.spkt=()=>{const d=FXD();d.soundOn=!d.soundOn;Music.el.muted=!d.soundOn;refreshFx()};
H.ptrack=async el=>{
  const d=FXD(),w=el.dataset.w,id=el.dataset.id,t=d[w].find(x=>x.id===id);if(!t)return;
  if(Music.preview===id&&!Music.el.paused){Music.el.pause();refreshFx();return}
  const u=await blobURL(t.blobId);if(!u){toast('Không đọc được tệp âm thanh này',{type:'err'});return}
  Music.preview=id;Music.src='';Music.el.src=u;Music.gesture=true;
  d.soundOn=true;Music.el.muted=false;
  if(w==='tracks')d.trackId=id;else d.proTrackId=id;
  try{await Music.el.play()}catch(e){toast('Trình duyệt chặn phát nhạc. Hãy bấm nút phát lại.',{type:'err'})}
  refreshFx();
};
H.ktrack=el=>{
  const d=FXD(),w=el.dataset.w,id=el.dataset.id,t=d[w].find(x=>x.id===id);if(!t)return;
  const sel=(w==='tracks'?d.trackId:d.proTrackId)===id;
  openSheet(t.name,`<div class="actl">${sel?`<button class="tap" data-act="tkclear" data-w="${w}">${ic('spkoff')}Bỏ chọn nhạc nền này</button>`:`<button class="tap" data-act="tkset" data-w="${w}" data-id="${id}">${ic('check')}Đặt làm nhạc nền</button>`}<button class="rd tap" data-act="tkdel" data-w="${w}" data-id="${id}">${ic('trash')}Xóa âm thanh</button></div>`);
};
H.tkset=el=>{const d=FXD();if(el.dataset.w==='tracks')d.trackId=el.dataset.id;else d.proTrackId=el.dataset.id;closeSheet();refreshFx()};
H.tkclear=el=>{const d=FXD();if(el.dataset.w==='tracks')d.trackId='';else d.proTrackId='';if(Music.preview){Music.el.pause();Music.preview=''}closeSheet();refreshFx()};
H.tkdel=el=>{
  const d=FXD(),w=el.dataset.w,id=el.dataset.id,t=d[w].find(x=>x.id===id);if(!t)return;
  if(Music.preview===id){Music.el.pause();Music.preview=''}
  d[w]=d[w].filter(x=>x.id!==id);d._del.push(t.blobId);
  if(w==='tracks'&&d.trackId===id)d.trackId='';
  if(w==='proTracks'&&d.proTrackId===id)d.proTrackId='';
  closeSheet();refreshFx();
};
const optHTML=(act,k,on,label,extra)=>`<button class="opt tap ${on?'on':''}" data-act="${act}" data-k="${k}" role="radio" aria-checked="${on}">${extra||''}<span class="oc">${label}</span><span class="ok2">${ic('check')}</span></button>`;
H.fontsheet=()=>{const d=FXD();openSheet('Phông chữ',Object.keys(FONTS).map(k=>optHTML('pickfont',k,d.font===k,`<span style="font-family:${FONTS[k].h},system-ui;font-weight:700;font-style:${FONTS[k].it}">${FONTS[k].n}</span><br><small class="dimtxt" style="font-family:${FONTS[k].b},system-ui">Cr29 Gaming - Tải game mod miễn phí</small>`)).join(''))};
H.pickfont=el=>{FXD().font=el.dataset.k;closeSheet();refreshFx()};
const colSheet=(w)=>{const d=FXD(),cur=w==='site'?d.siteColor:d.proColor;openSheet(w==='site'?'Đổi màu website':'Màu tài khoản Pro',`<div class="swg">${Object.keys(COLORS).map(k=>`<div class="swb ${cur===k?'on':''}" data-act="pickc" data-w="${w}" data-k="${k}" style="--c:${COLORS[k][1]}" role="radio" aria-checked="${cur===k}" tabindex="0"><i>${ic('check')}</i><span>${COLORS[k][0]}</span></div>`).join('')}</div><div class="dimtxt" style="font-size:13px;margin-top:6px">${w==='site'?'Màu viền giao diện admin (màu xanh nền giữ nguyên).':'Màu viền giao diện dành riêng cho tài khoản Pro.'}</div>`)};
H.colsite=()=>colSheet('site');
H.colpro=()=>colSheet('pro');
H.pickc=el=>{const d=FXD();if(el.dataset.w==='site')d.siteColor=el.dataset.k;else d.proColor=el.dataset.k;closeSheet();refreshFx()};
H.fxsheet=()=>{const d=FXD();openSheet('Hiệu ứng sương rơi',Object.keys(FXNAMES).map(k=>optHTML('pickfx',k,d.fx===k,FXNAMES[k],`<span class="fxp" style="color:${k==='gold'?'#ffc21a':k==='blue'?'#4fb0ff':'#fff'}">${ic(k==='none'?'x':'snow')}</span>`)).join(''))};
H.pickfx=el=>{const d=FXD();d.fx=el.dataset.k;closeSheet();refreshFx();FX.set(d.fx)};
H.savefx=async()=>{
  const d=FXD();
  for(const id of d._del){await Store.del('blobs',id);blobCache.delete(id)}
  DB.settings={siteColor:d.siteColor,proColor:d.proColor,font:d.font,fx:d.fx,soundOn:d.soundOn,tracks:d.tracks,trackId:d.trackId,proTracks:d.proTracks,proTrackId:d.proTrackId};
  await saveNow();
  Music.el.pause();Music.preview='';Music.el.muted=false;Music.src='';
  applyTheme();FX.set(DB.settings.fx);musicSync();
  ui.fxDraft=cloneSettings();refreshFx();
  saved('Lưu hiệu ứng thành công');
};

/* ---------- sự kiện chung ---------- */
document.addEventListener('click',e=>{
  if(e.target.id==='modal'){closeModal();return}
  if(e.target.id==='sheet'){closeSheet();return}
  const el=e.target.closest('[data-act]');
  if(!el)return;
  const fn=H[el.dataset.act];
  if(fn)fn(el,e);
});
document.addEventListener('keydown',e=>{
  const t=e.target;
  if(e.key==='Escape'){if($('#modal').classList.contains('on'))closeModal();else if($('#sheet').classList.contains('on'))closeSheet();return}
  if(e.key==='Enter'||e.key===' '){
    if(t.matches&&t.matches('[role="button"],[role="switch"],[role="radio"],[data-act]:not(button):not(input)')&&t.dataset.act){e.preventDefault();t.click();return}
  }
  if(e.key!=='Enter')return;
  if(t.matches&&t.matches('input.inp')){
    const f=t.closest('[data-form]');
    if(f){const b=$('[data-submit]',f);if(b){e.preventDefault();b.click()}}
    return;
  }
  if(t.id==='msgin'){e.preventDefault();H.send();return}
  if(['hq','sq','gsq','psq','mq'].includes(t.id)){
    e.preventDefault();
    const go_=t.closest('.sbar').querySelector('.go');if(go_)go_.click();
  }
});
document.addEventListener('input',e=>{
  const t=e.target;
  if(t.classList&&t.classList.contains('inp')&&t.id)setErr(t.id,'');
  if(t.id==='sq'){ui.sQ=t.value;updateSearch()}
  else if(t.id==='gsq'){ui.gQ=t.value;const l=$('#glist');if(l)l.innerHTML=gameListHTML()}
  else if(t.id==='psq'){ui.pQ=t.value;const l=$('#plist');if(l)l.innerHTML=plistHTML()}
  else if(t.id==='mq'){ui.mQ=t.value;const l=$('#convl');if(l)l.innerHTML=convHTML()}
  else if(t.id==='pmq'){ui.pmQ=t.value;const l=$('#pmlist');if(l)l.innerHTML=pmListHTML()}
  else if(t.id==='gchg'){const c=$('#gcnt');if(c)c.textContent=t.value.length+'/2000'}
});
document.addEventListener('change',e=>{
  const t=e.target;
  if(t.matches&&t.matches('input.ovl[data-fh]')){
    const fn=FH[t.dataset.fh],fs=Array.from(t.files||[]);
    setTimeout(()=>{try{t.value=''}catch(_){}},0);
    if(fn&&fs.length)fn(fs,t);
    return;
  }
  if(e.target.id==='pmf'){ui.pmFilter=e.target.value;const l=$('#pmlist');if(l)l.innerHTML=pmListHTML()}
});
window.addEventListener('popstate',()=>{
  if($('#modal').classList.contains('on')){closeModal();return}
  if($('#sheet').classList.contains('on')){closeSheet();return}
  if(stack.length>1){if(Rec.mr)recStop(false);stack.pop();render(true)}
});
$('#snd').addEventListener('click',()=>{
  Music.muted=!Music.muted;try{localStorage.setItem('cr29_muted',Music.muted?'1':'0')}catch(e){}
  if(Music.muted)Music.el.pause();musicSync();
});

/* ---------- đồng bộ giữa các tab ---------- */
function liveRefresh(){
  const n=topv().name;
  if((n==='messages'||n==='adminChat'||n==='feedback'||n==='copyright')&&$('#msgs')){refreshMsgs();return}
  const a=document.activeElement;
  if(a&&/^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName))return;
  if(n==='fx')return;
  render(true);
}
if(bc)bc.onmessage=async e=>{
  if(!e.data||e.data.from===TABID)return;
  await loadDB();SES=readSes();
  if(!checkSession()){stack=[{name:'account'}];render();return}
  applyTheme();FX.set(DB.settings.fx);liveRefresh();
};

/* ---------- khởi động ---------- */
function buildNav(){
  const it=[['home','home','Trang chủ'],['search','search','Tìm kiếm'],['messages','chat','Nhắn tin'],['account','user','Tài khoản']];
  $('#nav').innerHTML=hud(`<div class="navi" role="navigation" aria-label="Điều hướng chính">${it.map(([t,i,l])=>`<button class="nv tap" data-act="tab" data-tab="${t}" aria-label="${l}">${ic(i)}<span>${l}</span>${t==='messages'?`<span class="lockb" id="nvlock" title="Đăng nhập để nhắn tin">${ic('lock')}</span>`:''}</button>`).join('')}</div>`,'cut16 nav-hud');
}
(async function boot(){
  await loadDB();
  SES=readSes();checkSession();
  buildNav();applyTheme();FX.set(DB.settings.fx);
  try{history.replaceState({d:1},'')}catch(e){}
  render();
})();

