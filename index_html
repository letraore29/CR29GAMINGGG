/* ---------- hiệu ứng rơi (canvas) ---------- */
const FX=(()=>{
  const cv=()=>$('#fx');let mode='none',parts=[],raf=0,last=0,spr=null,W=0,H=0;
  const CFG={
    blue:{stops:['rgba(225,244,255,1)','rgba(90,175,255,.65)','rgba(40,120,255,0)'],size:[5,15],vy:[26,70],sway:14,tw:false},
    snow:{stops:['rgba(255,255,255,1)','rgba(232,244,255,.75)','rgba(205,228,255,0)'],size:[4,13],vy:[20,58],sway:24,tw:false},
    gold:{stops:['rgba(255,247,200,1)','rgba(255,200,50,.75)','rgba(255,170,0,0)'],size:[5,14],vy:[22,64],sway:16,tw:true}
  };
  function mkSprite(stops){const c=document.createElement('canvas');c.width=c.height=48;const x=c.getContext('2d');const g=x.createRadialGradient(24,24,0,24,24,24);g.addColorStop(0,stops[0]);g.addColorStop(.35,stops[1]);g.addColorStop(1,stops[2]);x.fillStyle=g;x.fillRect(0,0,48,48);return c}
  function resize(){const c=cv(),d=Math.min(window.devicePixelRatio||1,2);W=innerWidth;H=innerHeight;c.width=W*d;c.height=H*d;c.getContext('2d').setTransform(d,0,0,d,0,0)}
  function init(){
    const cfg=CFG[mode];spr=mkSprite(cfg.stops);resize();
    const n=Math.max(36,Math.min(100,Math.round(W*H/15000)));
    parts=Array.from({length:n},()=>mk(cfg,true));
  }
  function mk(cfg,anywhere){
    const r=(a,b)=>a+Math.random()*(b-a);
    return{x:Math.random()*W,y:anywhere?Math.random()*H:-20,s:r(cfg.size[0],cfg.size[1]),vy:r(cfg.vy[0],cfg.vy[1]),ph:Math.random()*6.28,f:r(.4,1.1),a:r(.45,.95),t:Math.random()*6.28};
  }
  function frame(ts){
    raf=requestAnimationFrame(frame);
    const dt=Math.min(.05,(ts-last)/1000||.016);last=ts;
    const c=cv(),x=c.getContext('2d'),cfg=CFG[mode];if(!cfg)return;
    x.clearRect(0,0,W,H);
    for(const p of parts){
      p.y+=p.vy*dt;p.t+=dt*p.f;
      if(p.y>H+20){Object.assign(p,mk(cfg,false));}
      const px=p.x+Math.sin(p.t+p.ph)*cfg.sway;
      x.globalAlpha=cfg.tw?p.a*(.55+.45*Math.sin(p.t*3+p.ph)):p.a;
      x.drawImage(spr,px-p.s,p.y-p.s,p.s*2,p.s*2);
    }
    x.globalAlpha=1;
  }
  function drawStatic(){const c=cv(),x=c.getContext('2d'),cfg=CFG[mode];x.clearRect(0,0,W,H);for(const p of parts){x.globalAlpha=p.a;x.drawImage(spr,p.x-p.s,p.y-p.s,p.s*2,p.s*2)}x.globalAlpha=1}
  return{
    set(m){
      if(m===mode&&raf)return;
      cancelAnimationFrame(raf);raf=0;mode=CFG[m]?m:'none';
      const c=cv();
      if(mode==='none'){c.style.display='none';c.getContext('2d').clearRect(0,0,c.width,c.height);return}
      c.style.display='block';init();
      if(matchMedia('(prefers-reduced-motion:reduce)').matches){drawStatic();return}
      last=performance.now();raf=requestAnimationFrame(frame);
    },
    resize(){if(mode!=='none'){cancelAnimationFrame(raf);raf=0;const m=mode;mode='none';this.set(m)}},
    pause(h){if(h){cancelAnimationFrame(raf);raf=0}else if(mode!=='none'&&!raf&&!matchMedia('(prefers-reduced-motion:reduce)').matches){last=performance.now();raf=requestAnimationFrame(frame)}}
  };
})();
window.addEventListener('resize',()=>FX.resize());
document.addEventListener('visibilitychange',()=>FX.pause(document.hidden));

