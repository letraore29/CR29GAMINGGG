const SESKEY='cr29_session';
let SES=null;
function readSes(){try{return JSON.parse(localStorage.getItem(SESKEY)||'null')}catch(e){return null}}
function setSes(s){SES=s;try{s?localStorage.setItem(SESKEY,JSON.stringify(s)):localStorage.removeItem(SESKEY)}catch(e){}}
const isAdmin=()=>!!SES&&SES.role==='admin';
const curUser=()=>SES&&SES.role==='user'?DB.users.find(u=>u.id===SES.uid)||null:null;
