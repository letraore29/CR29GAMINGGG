const Rec={mr:null,chunks:[],t0:0,tick:0,ctx:null,stream:null};
const V={},AFTER={};
let stack=[{name:'home'}],lastView='';
const NAVV=new Set(['home','search','messages','account']);
const FITV=['messages','adminChat','feedback'];
const isFit=n=>FITV.includes(n)&&!(n==='messages'&&isAdmin());
const ADMINV=new Set(['aEdit','fx','addGame','gameList','gameEdit','pInfo','pView','pEdit','pManage','pDetail','aFeed','aSupport','aCopy','aNotes','aPro','aChat']);
const USERV=new Set(['edit','downloads','favs','copyright','feedback','notes']);
const topv=()=>stack[stack.length-1];

function go(name,params){
  const sc=$('#scroll');topv().sy=sc.scrollTop;
  stack.push({name,params:params||{}});
  try{history.pushState({d:stack.length},'')}catch(e){}
  render();
}
function back(){
  if(Rec.mr)recStop(false);
  if(stack.length>1){stack.pop();render(true)}else switchTab('home');
}
function switchTab(t){
  if(t==='messages'&&!SES){toast('Đăng Nhập để nhắn tin',{type:'lock',ms:3200});return}
  if(Rec.mr)recStop(false);
  if(stack.length===1&&topv().name===t){$('#scroll').scrollTop=0;return}
  stack=[{name:t}];render();
}
function replaceTo(name,params){stack=[{name:'account'}];if(name!=='account')stack.push({name,params:params||{}});render()}
function render(restore){
  const cur=topv();let name=cur.name;
  if(ADMINV.has(name)&&!isAdmin()){stack=[{name:'account'}];return render()}
  if(USERV.has(name)&&!curUser()){stack=[{name:'account'}];return render()}
  if(lastView==='fx'&&name!=='fx')leaveFx();
  const sc=$('#scroll');
  sc.innerHTML=(V[name]||V.home)(cur.params||{});
  sc.classList.toggle('fit',isFit(name));
  $('#nav').classList.toggle('hide',!NAVV.has(name));
  $$('.nv').forEach(b=>b.classList.toggle('on',b.dataset.tab===name));
  const lk=$('#nvlock');if(lk)lk.style.display=SES?'none':'grid';
  applyTheme();hydrate(sc);
  sc.scrollTop=restore?(cur.sy||0):0;
  const snd=$('#snd');if(snd)snd.style.visibility=(NAVV.has(name)&&!isFit(name))?'visible':'hidden';
  lastView=name;
  if(AFTER[name])AFTER[name](cur.params||{});
  if(!Music.preview)musicSync();
}
