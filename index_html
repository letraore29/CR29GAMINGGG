function loadImage(file){
  return new Promise((res,rej)=>{
    const url=URL.createObjectURL(file),im=new Image();
    im.onload=()=>{URL.revokeObjectURL(url);res(im)};
    im.onerror=()=>{URL.revokeObjectURL(url);rej(new Error('Không đọc được ảnh'))};
    im.src=url;
  });
}
async function drawImg(file,max,square){
  const im=await loadImage(file);
  let sx=0,sy=0,sw=im.naturalWidth,sh=im.naturalHeight;
  if(square){const s=Math.min(sw,sh);sx=(sw-s)/2;sy=(sh-s)/2;sw=sh=s}
  const k=Math.min(1,max/Math.max(sw,sh)),cw=Math.max(1,Math.round(sw*k)),ch=Math.max(1,Math.round(sh*k));
  const c=document.createElement('canvas');c.width=cw;c.height=ch;
  const x=c.getContext('2d');x.fillStyle='#061a44';x.fillRect(0,0,cw,ch);x.drawImage(im,sx,sy,sw,sh,0,0,cw,ch);
  return c;
}
const imgToDataURL=async(f,max,q,square)=>(await drawImg(f,max,square)).toDataURL('image/jpeg',q);
const imgToBlob=async(f,max,q)=>{const c=await drawImg(f,max,false);return new Promise(r=>c.toBlob(b=>r(b),'image/jpeg',q))};
function placeholderImg(name){
  const t=esc(name.slice(0,24));
  const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="460" height="200"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0d45c8"/><stop offset="1" stop-color="#051a52"/></linearGradient></defs><rect width="460" height="200" fill="url(#g)"/><text x="230" y="112" text-anchor="middle" font-family="Arial,sans-serif" font-weight="800" font-style="italic" font-size="34" fill="#fff">${t}</text></svg>`;
  return 'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg);
}
async function copyText(t){
  try{await navigator.clipboard.writeText(t)}catch(e){const ta=document.createElement('textarea');ta.value=t;ta.style.cssText='position:fixed;opacity:0';document.body.appendChild(ta);ta.select();try{document.execCommand('copy')}catch(_){}ta.remove()}
  toast('Đã sao chép',{type:'info',ms:2000});
}
function openLink(u){
