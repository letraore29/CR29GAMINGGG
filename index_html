function checkSession(){
  if(!SES)return true;
  if(SES.role==='admin')return true;
  const u=curUser();
  if(!u){setSes(null);return false}
  if(u.locked){setSes(null);toast('Tài Khoản của bạn đã bị Khóa',{type:'err',ms:4500});return false}
  return true;
}
let loginFails=0,loginBlock=0;
function doLogin(name,pw){
  if(now()<loginBlock)return{ok:false,msg:'Nhập sai quá nhiều lần. Vui lòng thử lại sau '+Math.ceil((loginBlock-now())/1000)+' giây.'};
  const k=ukey(name);
  const fail=()=>{loginFails++;if(loginFails>=5){loginBlock=now()+30000;loginFails=0}return{ok:false,msg:'Sai tên đăng nhập hoặc mật khẩu'}};
  if(k===ukey(DB.admin.username)){
    if(hashPw(pw,DB.admin.salt)!==DB.admin.hash)return fail();
    loginFails=0;setSes({role:'admin'});return{ok:true,role:'admin'};
  }
  const u=DB.users.find(x=>ukey(x.username)===k);
  if(!u||u.password!==pw)return fail();
  if(u.locked)return{ok:false,locked:true,msg:'Tài Khoản của bạn đã bị Khóa'};
  loginFails=0;setSes({role:'user',uid:u.id});return{ok:true,role:'user'};
}

