const recEls=()=>$$('[data-act="mic"]');
function showRecBar(on){const b=$('#recbar');if(b)b.classList.toggle('on',on);recEls().forEach(e=>e.classList.toggle('rec',on))}
function updRecBar(){const s=Math.floor((now()-Rec.t0)/1000),t=$('#rectime');if(t)t.textContent='Đang ghi âm '+Math.floor(s/60)+':'+p2(s%60)}
function recMime(){
  const c=['audio/webm;codecs=opus','audio/webm','audio/mp4','audio/ogg;codecs=opus','audio/aac'];
  for(const m of c){try{if(MediaRecorder.isTypeSupported(m))return m}catch(e){}}
  return '';
}
async function recStart(){
  if(Rec.mr)return true;
  const ctx=chatCtx();if(!ctx)return false;
  if(window.isSecureContext===false){toast('Trình duyệt chặn micro vì trang chưa chạy bằng HTTPS. Hãy mở web bằng địa chỉ https:// hoặc dùng nút chọn tệp ghi âm.',{type:'err',ms:6000});return false}
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia||!window.MediaRecorder){toast('Trình duyệt này không hỗ trợ ghi âm trực tiếp. Hãy mở web bằng Chrome hoặc Safari.',{type:'err',ms:5000});return false}
  let st;
  try{st=await navigator.mediaDevices.getUserMedia({audio:true})}
  catch(e){
    const n=e&&e.name;
    toast(n==='NotFoundError'?'Không tìm thấy micro trên thiết bị.':n==='NotReadableError'?'Micro đang được ứng dụng khác sử dụng.':'Bạn chưa cho phép dùng micro. Hãy cho phép quyền micro cho trang web trong cài đặt trình duyệt.',{type:'err',ms:5000});
    return false;
  }
  let mr;
  try{const m=recMime();mr=m?new MediaRecorder(st,{mimeType:m}):new MediaRecorder(st)}
  catch(e){try{st.getTracks().forEach(t=>t.stop())}catch(_){}toast('Không khởi động được ghi âm trên trình duyệt này.',{type:'err'});return false}
  Rec.mr=mr;Rec.stream=st;Rec.chunks=[];Rec.ctx=ctx;Rec.t0=now();
  mr.ondataavailable=e=>{if(e.data&&e.data.size)Rec.chunks.push(e.data)};
  try{mr.start()}catch(e){Rec.mr=null;try{st.getTracks().forEach(t=>t.stop())}catch(_){}toast('Không bắt đầu ghi âm được.',{type:'err'});return false}
  showRecBar(true);updRecBar();Rec.tick=setInterval(updRecBar,250);
  return true;
}
function recStop(send){
  const mr=Rec.mr;if(!mr)return;
  const ctx=Rec.ctx,t0=Rec.t0;
  mr.onstop=async()=>{
    clearInterval(Rec.tick);try{Rec.stream.getTracks().forEach(t=>t.stop())}catch(e){}
    const chunks=Rec.chunks;Rec.mr=null;showRecBar(false);
    if(!send||!chunks.length)return;
    if(now()-t0<700){toast('Bản ghi âm quá ngắn',{type:'info'});return}
    const blob=new Blob(chunks,{type:mr.mimeType||'audio/webm'});
    await sendMsg({...ctx,type:'voice',file:new File([blob],/mp4|aac/.test(blob.type)?'ghi-am.m4a':'ghi-am.webm',{type:blob.type})});
    refreshMsgs(true);
  };
  try{mr.stop()}catch(e){Rec.mr=null;showRecBar(false)}
}
let micDown=0;
document.addEventListener('pointerdown',async e=>{
  const b=e.target.closest('[data-act="mic"]');if(!b)return;
  e.preventDefault();
  if(Rec.mr){recStop(true);micDown=0;return}
  micDown=now();
  const ok=await recStart();if(!ok)micDown=0;
});
document.addEventListener('pointerup',()=>{
  if(!micDown)return;
  const held=now()-micDown;micDown=0;
  if(held>800)recStop(true); // giữ để nói: thả tay là gửi. Chạm nhanh: tiếp tục ghi, chạm lần nữa để gửi.
});
