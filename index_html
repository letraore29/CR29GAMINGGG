/* ---------- lưu trữ: IndexedDB (có phương án dự phòng) ---------- */
const Store=(()=>{
  let dbp=null;const mem={kv:new Map(),blobs:new Map()};
  function open(){
    if(dbp)return dbp;
    dbp=new Promise(res=>{
      try{
        const r=indexedDB.open('cr29-gaming',1);
        r.onupgradeneeded=()=>{const d=r.result;if(!d.objectStoreNames.contains('kv'))d.createObjectStore('kv');if(!d.objectStoreNames.contains('blobs'))d.createObjectStore('blobs')};
        r.onsuccess=()=>res(r.result);r.onerror=()=>res(null);r.onblocked=()=>res(null);
      }catch(e){res(null)}
    });
    return dbp;
  }
  function tx(store,mode,fn){
    return open().then(d=>d?new Promise(res=>{
      try{const t=d.transaction(store,mode);const rq=fn(t.objectStore(store));t.oncomplete=()=>res({ok:true,v:rq?rq.result:undefined});t.onerror=()=>res(null);t.onabort=()=>res(null)}catch(e){res(null)}
    }):null);
  }
  return{
    async get(s,k){const r=await tx(s,'readonly',o=>o.get(k));if(r)return r.v;if(s==='kv'){try{const j=localStorage.getItem('cr29_kv_'+k);if(j)return JSON.parse(j)}catch(e){}}return mem[s].get(k)},
    async set(s,k,v){const r=await tx(s,'readwrite',o=>o.put(v,k));if(r)return true;mem[s].set(k,v);if(s==='kv'){try{localStorage.setItem('cr29_kv_'+k,JSON.stringify(v))}catch(e){}}return false},
    async del(s,k){await tx(s,'readwrite',o=>o.delete(k));mem[s].delete(k)}
  };
})();
const blobCache=new Map();
async function putBlob(b){const id=gid();await Store.set('blobs',id,b);return id}
async function blobURL(id){if(!id)return '';if(blobCache.has(id))return blobCache.get(id);const b=await Store.get('blobs',id);if(!b)return '';const u=URL.createObjectURL(b);blobCache.set(id,u);return u}
function hydrate(root){$$('[data-blob]',root||document).forEach(el=>{if(el.dataset.h)return;el.dataset.h='1';blobURL(el.dataset.blob).then(u=>{if(!u)return;if(el.tagName==='A')el.href=u;else el.src=u})})}

